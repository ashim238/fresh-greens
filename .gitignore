# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# Also ignore a bare `.env` — `.env*.local` doesn't match it, and a stray
# `.env` with a real token would otherwise get committed (repo is public).
.env

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Claude Code session metadata (worktrees, agent state). Not part of
# the project source; excluded from the submitted snapshot.
.claude/

# Superpowers brainstorm artifacts (visual-companion mockups). Local
# scratch space; don't commit.
.superpowers/

# graphify-generated knowledge graph + wiki. Regenerated locally via
# `graphify update .`; not part of the source tree.
graphify-out/

# Superpowers ephemeral plans (if regenerated) — canonical shipped plans live in
# docs/archive/superpowers/plans/
docs/superpowers/plans/

# Superpowers session observation logs. Local plugin telemetry.
skill-observations/

# Impeccable hook cache. Regenerated on demand by the design hook.
.impeccable/hook.cache.json
