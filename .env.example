# Copy this file to `.env.local` and fill in your token.
# `.env.local` is gitignored — the token never enters the repo.

# Mapbox Geocoding access token. Sign up at https://account.mapbox.com/
# (free tier: 100K req/month, 600/min). Powers /search's POI search.
# Without this set, /search returns empty results.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Fuel prices on Gas search: demo (default) | live (no provider in v1)
# EXPO_PUBLIC_FUEL_PRICE_MODE=demo

# Community reports cloud sync (B1). Optional — without these, reports stay
# device-local (AsyncStorage). Create table `community_reports` in Supabase;
# see lib/api/sources/community-cloud.ts header for column shape.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
