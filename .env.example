# Copy this file to `.env.local` and fill in the values you need.
# `.env.local` is gitignored. Credentials never enter the repo.

# Mapbox Geocoding access token. Sign up at https://account.mapbox.com/
# (free tier: 100K req/month, 600/min). Powers /search's POI search.
# Without this set, /search returns empty results.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Fuel prices on Gas search: demo (default) | live (no provider in v1)
# EXPO_PUBLIC_FUEL_PRICE_MODE=demo

# Supabase auth, community reports, roles, and moderation. Optional for local
# development. Without both values the app preserves local-only behavior.
# Apply the checked-in migrations in order instead of creating tables manually:
#   supabase/migrations/0001_m1.1_initial.sql
#   supabase/migrations/0002_supabase_sdk_contract_fix.sql
# Run the safe promotion only after the first permanent Apple login exists:
#   supabase/seed.sql
# Use the public publishable key only. Never put a service-role key in the app.
# For real-iPhone acceptance, use a signed local Xcode/CNG development build
# with both public values supplied by the copied, gitignored `.env.local`.
# Do not configure EAS, create production/store builds, or upload to TestFlight
# until every manual row in the release runbook passes.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# DOT 511 on corridor bbox legs (B4): off | demo (default) | live
# EXPO_PUBLIC_DOT_511_MODE=demo
# Optional live feed template with {state},{south},{west},{north},{east}
# EXPO_PUBLIC_DOT_511_FEED_URL=
