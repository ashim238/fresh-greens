{
  "expo": {
    "name": "fresh-greens",
    "slug": "fresh-greens",
    "scheme": "freshgreens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fresh Greens uses your location to suggest routes that maximize visibility, daylight, and familiarity."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Fresh Greens records audio during traffic stops as ambient protection. Recordings are saved to your account and never shared without your action."
        }
      ]
    ]
  }
}
